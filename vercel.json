{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/checkout/zpay-go", "destination": "/api/checkout/zpay?action=go" },
    { "source": "/api/checkout/zpay-notify", "destination": "/api/checkout/zpay?action=notify" },
    { "source": "/api/checkout/zpay-return", "destination": "/api/checkout/zpay?action=return" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
