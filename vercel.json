{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/sitemaps/sitemap.xml" },
    { "source": "/api/checkout/zpay-go", "destination": "/api/checkout/zpay?action=go" },
    { "source": "/api/checkout/zpay-notify", "destination": "/api/checkout/zpay?action=notify" },
    { "source": "/api/checkout/zpay-return", "destination": "/api/checkout/zpay?action=return" },
    { "source": "/api/geo", "destination": "/api/checkout/zpay?action=geo" },
    { "source": "/api/checkout/paypal-capture", "destination": "/api/checkout/paypal?action=capture" },
    { "source": "/api/checkout/paypal-webhook", "destination": "/api/checkout/paypal?action=webhook" }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    },
    {
      "source": "/assets/disk.webp",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noimageindex, noarchive" }
      ]
    },
    {
      "source": "/assets/dragon.png",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noimageindex, noarchive" }
      ]
    },
    {
      "source": "/assets/video-opt.mp4",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noimageindex, noarchive, max-video-preview:0" }
      ]
    },
    {
      "source": "/assets/video-2-opt.mp4",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noimageindex, noarchive, max-video-preview:0" }
      ]
    },
    {
      "source": "/assets/obf/d",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noimageindex, noarchive" }
      ]
    },
    {
      "source": "/assets/obf/v",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noimageindex, noarchive, max-video-preview:0" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
